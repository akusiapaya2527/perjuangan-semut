# Salin ke /opt/perjuangansemut/perjuangansemut.env di server, isi nilai asli,
# lalu chmod 600. JANGAN commit file aslinya ke git.
# Kredensial admin dashboard emulator (http://127.0.0.1:8080/admin via SSH tunnel).
# Wajib diganti dari default bawaan repo sebelum go-live.
ADMIN_EMAIL=ganti-dengan-email-admin
ADMIN_PASSWORD=ganti-dengan-password-kuat

[Unit]
Description=Perjuangan Semut - emulator backend (HTTP 8080 + game sockets 9001-9003, localhost only)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/perjuangansemut/app/emulator
EnvironmentFile=/opt/perjuangansemut/perjuangansemut.env
ExecStart=/opt/perjuangansemut/.venv/bin/python emulator.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
